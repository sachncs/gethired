# gethired environment configuration
# Copy this file to .env and fill in your values.
# Note: .env is gitignored — do not commit your real keys.

# Auth token for the chosen provider.
# Used by MiniMax (Anthropic-compatible) and Anthropic native.
API_KEY=

# Optional: override the base URL. Defaults to the MiniMax platform
# base URL when MODEL is a MiniMax model.
# For MiniMax: https://api.minimax.io/anthropic
# For Anthropic native: leave blank or set https://api.anthropic.com
BASE_URL=https://api.minimax.io/anthropic

# Model selection — any pydantic-ai-supported model string.
# Examples:
#   MiniMax-M3                     → MiniMax platform (auto-routed)
#   MiniMax-M2.7-highspeed         → other MiniMax models
#   anthropic:claude-sonnet-4-5    → Anthropic native
#   openai:gpt-5                   → OpenAI native (requires OPENAI_API_KEY)
MODEL=MiniMax-M3

# Optional: OpenAI key (only needed if MODEL starts with openai:)
OPENAI_API_KEY=

# Draft model for cheap preflight (optional)
DRAFT_MODEL=

# Web search provider — duckduckgo (default, no key) or anthropic or openai
WEBSEARCH_PROVIDER=duckduckgo

# PII consent timestamp — managed automatically by the CLI
RESUME_TAILOR_CONSENT=
