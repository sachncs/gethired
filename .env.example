# cp .env.example .env and fill in your keys

# Provider keys (only the one for your chosen provider is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=

# Model selection — any pydantic-ai-supported model string
# Examples:
#   anthropic:claude-sonnet-4-5    → Anthropic native
#   openai:gpt-5                   → OpenAI native
#   anthropic:MiniMax-M3           → MiniMax platform via Anthropic-compatible API
#   MiniMax-M3                     → bare name, defaults to MiniMax platform
#   M2.7-highspeed, MiniMax-M2.1   → other MiniMax models
MODEL=anthropic:MiniMax-M3

# Optional: override the base URL (defaults to MiniMax platform when MODEL is a MiniMax model)
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# Draft model for cheap preflight (optional)
DRAFT_MODEL=

# Web search provider — duckduckgo (default, no key) or anthropic or openai
WEBSEARCH_PROVIDER=duckduckgo

# Optional: Logfire observability
LOGFIRE_TOKEN=

# PII consent timestamp — managed automatically by the CLI
RESUME_TAILOR_CONSENT=

